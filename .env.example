# ── Session ─────────────────────────────────────────────────────
# Signs session cookies. MUST be a fixed random value — if it changes
# between restarts, every user is logged out. Generate with:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=change_me_to_a_long_random_string

# ── LLM backends (at least one is required) ─────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Local inference via Ollama. Host-installed Ollama:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama as a compose service (uncomment it in docker-compose.yml):
#   OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=

# ── Optional ────────────────────────────────────────────────────
# Comma-separated model IDs preselected for new chats
# DEFAULT_MODELS=gpt-4o

# Close public registration AFTER creating your admin account
# ENABLE_SIGNUP=false

# Enable web search inside the RAG engine
# ENABLE_RAG_WEB_SEARCH=true

# Host port to publish (container always listens on 8080)
# OPEN_WEBUI_PORT=3000
